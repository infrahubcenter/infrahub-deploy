# Infra Hub Center -- docker compose settings. Copy to .env and fill in.
# Generate the secrets with:
#   openssl rand -hex 24      (POSTGRES_PASSWORD -- hex keeps the DB URL valid)
#   openssl rand -hex 48      (JWT_SECRET)
#   openssl rand -base64 32   (SSH_CREDENTIAL_ENCRYPTION_KEY, must be 32 bytes)

# Image tag on docker.io/infrahubcenter
INFRAHUB_VERSION=1.0.0

# The address people and agents use to reach this server -- a domain or
# the server's IP, never "localhost" if agents run on other machines.
PUBLIC_URL=http://your-server-ip
# Host port the gateway listens on (match it in PUBLIC_URL if not 80).
INFRAHUB_HTTP_PORT=80
# true once PUBLIC_URL is https:// (TLS in front of the gateway).
COOKIE_SECURE=false

# ---------------- Database: choose ONE ----------------
# A) Built-in PostgreSQL container (default). Keep this line and set a password:
COMPOSE_PROFILES=postgres
POSTGRES_DB=infrahub
POSTGRES_USER=infrahub
POSTGRES_PASSWORD=change-me-hex-only

# B) Managed / external PostgreSQL 14+ (AWS RDS, Google Cloud SQL, Azure
#    Database for PostgreSQL, your own server). Delete COMPOSE_PROFILES
#    above and set the connection string (URL-encode special characters in
#    the password; use sslmode=require for cloud databases):
# DATABASE_URL=postgres://infrahub:<password>@your-db-host:5432/infrahub?sslmode=require
# ------------------------------------------------------

JWT_SECRET=change-me
SSH_CREDENTIAL_ENCRYPTION_KEY=change-me-32-bytes-base64

# First admin, created on first start only (password: 12+ characters).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# Plan: leave empty for the free Community plan (1 user, 2 VMs, 1 database,
# 1 S3 bucket, 1 Docker host, 1 Kubernetes cluster, 3-day metrics). For Team,
# Business or Enterprise paste the license key you received from
# infrahubcenter@gmail.com; the API enforces whichever plan the key grants.
INFRAHUB_LICENSE_KEY=
INFRAHUB_MARKETING_URL=
