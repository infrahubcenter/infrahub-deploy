# Infra Hub Center -- docker compose settings. Copy to .env and fill in.
# Generate the secrets with:
#   openssl rand -hex 24      (POSTGRES_PASSWORD -- hex keeps the DB URL valid)
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -base64 32   (SSH_CREDENTIAL_ENCRYPTION_KEY, must be 32 bytes)

# Image tag on docker.io/infrahubcenter
INFRAHUB_VERSION=1.0.0

# The address people and agents use to reach this server -- a domain or
# the server's IP, never "localhost" if agents run on other machines.
PUBLIC_URL=http://your-server-ip
# Host port the gateway listens on (match it in PUBLIC_URL if not 80).
INFRAHUB_HTTP_PORT=80
# true once PUBLIC_URL is https:// (TLS in front of the gateway).
COOKIE_SECURE=false

POSTGRES_DB=infrahub
POSTGRES_USER=infrahub
POSTGRES_PASSWORD=change-me-hex-only

JWT_SECRET=change-me
SSH_CREDENTIAL_ENCRYPTION_KEY=change-me-32-bytes-base64

# First admin, created on first start only.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Owner
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# community | team | business | enterprise
INFRAHUB_PLAN=community
INFRAHUB_MARKETING_URL=
